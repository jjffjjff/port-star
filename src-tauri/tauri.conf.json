{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "port-star",
  "version": "0.1.0",
  "identifier": "com.edtra.portstar",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PortStar",
        "width": 380,
        "height": 520,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "transparent": false,
        "alwaysOnTop": false,
        "visible": false,
        "center": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

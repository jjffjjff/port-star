{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": [
          {
            "element": "button",
            "message": "Use <Button> from the design system instead of <button>."
          },
          {
            "element": "input",
            "message": "Use <Input> from the design system instead of <input>."
          },
          {
            "element": "textarea",
            "message": "Use <Input> from the design system instead of <textarea>."
          },
          {
            "element": "p",
            "message": "Use <Typography> from the design system instead of <p>."
          },
          {
            "element": "h1",
            "message": "Use <Typography> from the design system instead of <h1>."
          },
          {
            "element": "h2",
            "message": "Use <Typography> from the design system instead of <h2>."
          },
          {
            "element": "span",
            "message": "Use <Typography> from the design system instead of <span>."
          }
        ]
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/general/Alert/**",
              "components/general/Badge/**",
              "components/general/Button/**",
              "components/general/Card/**",
              "components/general/Container/**",
              "components/general/Input/**",
              "components/general/Sidebar/**",
              "components/general/TopBar/**",
              "components/general/Typography/**",
              "ui_kits/meridian/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|Instrument Serif|DM Mono|JetBrains Mono|Montserrat|Space Grotesk))/i]",
        "message": "Font not provided by the design system. Available: Inter, Instrument Serif, DM Mono, JetBrains Mono, Montserrat, Space Grotesk."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alert'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|children|className|key|ref|className|style|children)$/]",
        "message": "<Alert> doesn't accept that prop. Declared props: variant, children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|children|className|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: variant, children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|padding|children|className|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: variant, padding, children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Container'] > JSXAttribute > JSXIdentifier[name!=/^(?:maxWidth|children|className|key|ref|className|style|children)$/]",
        "message": "<Container> doesn't accept that prop. Declared props: maxWidth, children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|error|multiline|rows|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, error, multiline, rows."
      },
      {
        "selector": "JSXOpeningElement[name.name='SidebarChildItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|onClick|key|ref|className|style|children)$/]",
        "message": "<SidebarChildItem> doesn't accept that prop. Declared props: key, label, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|onClick|key|ref|className|style|children)$/]",
        "message": "<NavItem> doesn't accept that prop. Declared props: key, label, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Typography'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|as|secondary|children|className|key|ref|className|style|children)$/]",
        "message": "<Typography> doesn't accept that prop. Declared props: variant, as, secondary, children, className."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "Alert": {
        "replaces": []
      },
      "Badge": {
        "replaces": []
      },
      "Button": {
        "replaces": [
          "button"
        ]
      },
      "Card": {
        "replaces": []
      },
      "Container": {
        "replaces": []
      },
      "Input": {
        "replaces": [
          "input",
          "textarea"
        ]
      },
      "SidebarChildItem": {
        "replaces": []
      },
      "NavItem": {
        "replaces": []
      },
      "Typography": {
        "replaces": [
          "p",
          "h1",
          "h2",
          "span"
        ]
      }
    },
